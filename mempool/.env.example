# Ethereum Node WebSocket URL
# Copy this file to .env and fill in your actual URL

# QuickNode example:
# ETH_WS_URL=wss://your-endpoint.quiknode.pro/YOUR-TOKEN/

# Infura example:
# ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR-PROJECT-ID

# Alchemy example:
# ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# Local node example:
# ETH_WS_URL=ws://localhost:8546

ETH_WS_URL=wss://your-node-url-here
